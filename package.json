{
  "name": "voidborne",
  "version": "6.0.0-d",
  "private": true,
  "description": "A procedural universe in one self-contained HTML file: raw WebGL2 + Web Audio, no assets, no libraries.",
  "type": "module",
  "scripts": {
    "format": "node tools/format-proof.mjs",
    "format:check": "node tools/format-proof.mjs --check",
    "build": "node build.mjs --check",
    "build:debug": "node build.mjs --check --debug",
    "watch": "node build.mjs --watch",
    "test:seeds": "node tools/seed-test.mjs",
    "test:seeds:ci": "node tools/seed-test.mjs --swiftshader",
    "test:shots": "node tests/shots.mjs",
    "test:shots:baseline": "node tests/shots.mjs --update",
    "bench": "node tests/bench.mjs"
  },
  "devDependencies": {
    "acorn": "^8.12.0",
    "playwright": "^1.50.0",
    "prettier": "3.8.1"
  },
  "engines": {
    "node": ">=18"
  }
}
